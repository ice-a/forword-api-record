# ===== 后端服务配置 =====
# MongoDB 连接地址（必填）
MONGODB_URI=mongodb://localhost:27017/relay_station

# 后台管理密码（必填，用于后台增删改查鉴权）
ADMIN_PASSWORD=change_me_strong_password

# 后端服务端口（默认 3000）
PORT=3000

# ===== 图床配置（CloudFlare-ImgBed）=====
IMGBED_URL=https://img.020417.xyz
IMGBED_AUTH=muzi

# ===== 前端配置 =====
# 前端构建后引用的后端 API 基础地址（生产环境使用，开发环境走 Vite 代理）
VITE_API_BASE=/api
