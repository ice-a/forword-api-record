# ===== 后端服务配置 =====
# MongoDB 连接地址（必填）
MONGODB_URI=mongodb://localhost:27017/relay_station

# 后台管理密码（必填，用于后台增删改查鉴权）
ADMIN_PASSWORD=change_me_strong_password

# 后端服务端口（默认 3000）
PORT=3000

# ===== 全局 AI 配置（调用 AI 生成简介/内容时使用）=====
# 仅在页面未单独保存时才回退到以下环境变量默认值
GLOBAL_AI_BASE_URL=
GLOBAL_AI_API_KEY=
# 调用生成时使用的默认模型（如 gpt-4o、claude-3-5-sonnet 等）
GLOBAL_AI_MODEL=

# ===== 前端配置 =====
# 前端构建后引用的后端 API 基础地址（生产环境使用，开发环境走 Vite 代理）
VITE_API_BASE=/api
